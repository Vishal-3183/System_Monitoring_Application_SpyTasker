QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
}

QPushButton {
    background-color: #3c3f41;
    border: 1px solid #555;
    padding: 5px;
    border-radius: 5px;
}

QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #2f2f2f;
    color: #f0f0f0;
    gridline-color: #444;
    selection-background-color: #3a82f7;
    selection-color: #ffffff;
    border: 1px solid #555;
    font-size: 14px;
    border-radius: 6px;
}

QTableWidget::item:hover {
    background-color: #3c3f41;
}

QHeaderView::section {
    background-color: #3c3f41;
    color: #f0f0f0;
    padding: 5px;
    border: 1px solid #444;
}

QProgressBar {
    border: 1px solid #555;
    border-radius: 5px;
    text-align: center;
    background-color: #1e1e1e;
    color: #f0f0f0;
    height: 20px;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: #3a82f7;
    width: 20px;
    margin: 0.5px;
    border-radius: 5px;
}
